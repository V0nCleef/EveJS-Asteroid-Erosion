{
  "schemaVersion": 3,
  "id": "asteroid-erosion",
  "displayName": "Asteroid Erosion",
  "version": "0.2.0",
  "description": "Ore-volume shrinking, size-scaled dust and personal depletion styles. Configure in the in-game MODS menu; update through the Launcher.",
  "kind": "loader",
  "supportedBackends": ["native"],
  "activation": {"strategy": "loader_rename"},
  "restart": "game_server",
  "compatibility": {"evejsVersions": ["0.12.9"]},
  "launcherApi": {"version": 1, "minLauncherVersion": "1.0.69"},
  "updates": {
    "provider": "github",
    "repository": "V0nCleef/EveJS-Asteroid-Erosion",
    "asset": "AsteroidErosion-{version}.zip",
    "channel": "stable",
    "tagPrefix": "v",
    "preserveFiles": ["config.json"]
  },
  "clientMenu": {"apiVersion": 1, "entrypoint": "client/menu.py"}
}
